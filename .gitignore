# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Sorties générées
*.pdf
!docs/*.pdf

# Journal de démonstration : des vocaux d'artisans réels. Ne quitte jamais la machine
# sur laquelle il a été enregistré.
journal/

# Suivi d'exécution : recopie les transcriptions et les devis, donc parfois des noms
# et des adresses de clients. Voir app/suivi.py.
logs/

# OS / éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Aperçu local du template
apercu.html

# Compteurs de dépense — ils survivent au redémarrage et sont propres à chaque
# machine. En conteneur, ce dossier doit être un volume, sinon chaque déploiement
# remet les plafonds à zéro.
var/

# Clé de compte de service Firebase. Un fichier commité ici donne l'administration
# complète du projet — comptes et base — à qui lit le dépôt.
firebase-service-account.json
*-firebase-adminsdk-*.json

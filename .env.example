# ---------------------------------------------------------------------------
# Copier ce fichier en `.env` et renseigner les valeurs. Le `.env` n'est jamais commité.
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- Clés API -------------------------------------------------------------

# La seule clé nécessaire par défaut : elle sert à la transcription et au chiffrage.
# https://platform.openai.com/api-keys — facturé à l'usage, pas de tier gratuit.
OPENAI_API_KEY=

# Nécessaire seulement si TRANSCRIPTION_PROVIDER=groq ou STRUCTURATION_PROVIDER=groq.
# Compte gratuit sur https://console.groq.com — pas de carte bancaire.
GROQ_API_KEY=

# Nécessaire seulement si STRUCTURATION_PROVIDER=anthropic. https://console.anthropic.com
ANTHROPIC_API_KEY=


# --- Mode hors-ligne ------------------------------------------------------

# true  : rejoue les extractions enregistrées dans tests/fixtures/. Aucun appel API,
#         aucun euro dépensé. C'est le mode de travail pour itérer sur le PDF et le front.
# false : appelle réellement les API de transcription et de chiffrage.
USE_FIXTURES=true


# --- Journal de démonstration ---------------------------------------------

# Garde sur disque chaque vocal réel, sa transcription et ce que le modèle en a tiré,
# dans journal/<date>/<heure-empreinte>/. À armer avant une tournée de rendez-vous :
# ce sont ces enregistrements-là, et pas des fonctionnalités, qui font progresser le
# prompt. Rien n'est jamais relu par l'application, et le dossier est ignoré par git.
#
# Il enregistre la voix de quelqu'un : le dire à l'artisan avant n'est pas une option.
JOURNAL=false


# --- Suivi d'exécution ----------------------------------------------------

# Tout ce qui se passe est écrit dans logs/devis-vocal.log en même temps qu'à l'écran :
# chaque étape et sa durée, le fournisseur appelé, les tokens et le coût, les totaux du
# devis, et la pile complète des erreurs. Le fichier est archivé chaque nuit sous
# logs/devis-vocal.log.<date> et le dossier est ignoré par git. Rien à armer.

# Recopie aussi la transcription et le JSON d'extraction dans le log. C'est ce qui rend
# un devis raté compréhensible le soir même ; passer à false si le fichier devient lourd.
LOG_CONTENU=true

# Nombre de journées archivées avant effacement.
LOG_RETENTION_JOURS=30


# --- Modèles --------------------------------------------------------------

# Qui chiffre le devis : `openai`, `anthropic`, `groq` ou `autre`. `openai` est le choix
# par défaut. `groq` est gratuit et sert à dégrossir : les prix dictés par l'artisan sont
# repris à l'identique, mais les prix estimés sortent 40 % trop bas. Voir
# CONTRIBUTING.md. `openai` et `groq` passent par le même chemin de code — même prompt,
# même sortie contrainte — donc la comparaison entre fournisseurs est honnête.
#
# Laisse la ligne vide et le moteur se déduit de la clé renseignée plus haut : une clé
# OpenAI donne `openai`, une clé Anthropic seule donne `anthropic`, et ainsi de suite.
# La remplir sert à forcer un moteur quand plusieurs clés cohabitent — c'est le cas
# quand GROQ_API_KEY est là pour la transcription mais qu'OpenAI doit chiffrer.
# Dans tous les cas, le moteur réellement utilisé est affiché à l'écran et sur /health.
STRUCTURATION_PROVIDER=

MODEL_STRUCTURATION_OPENAI=gpt-5
MODEL_STRUCTURATION_GROQ=openai/gpt-oss-120b
# Modèle Anthropic, si STRUCTURATION_PROVIDER=anthropic.
MODEL_STRUCTURATION=claude-opus-5


# --- N'importe quel autre fournisseur -------------------------------------

# Quasiment toutes les API de modèles parlent le format OpenAI. Les trois variables
# ci-dessous suffisent donc à en brancher une que le projet ne connaît pas : Mistral,
# DeepSeek, OpenRouter, Together, xAI, ou un modèle servi en local par Ollama ou vLLM.
# Poser STRUCTURATION_PROVIDER=autre pour les activer.
#
#   Mistral    https://api.mistral.ai/v1              mistral-large-latest
#   DeepSeek   https://api.deepseek.com/v1            deepseek-chat
#   OpenRouter https://openrouter.ai/api/v1           <éditeur>/<modèle>
#   Ollama     http://localhost:11434/v1              qwen2.5:14b   (clé bidon acceptée)
#
# Attention : tous ne savent pas imposer un schéma JSON. Ceux qui refusent basculent
# automatiquement sur un mode moins contraint, et un avertissement part dans les logs.
# La sortie reste validée par Pydantic, mais un modèle faible échouera plus souvent.
STRUCTURATION_BASE_URL=
STRUCTURATION_API_KEY=
MODEL_STRUCTURATION_AUTRE=


# --- Transcription --------------------------------------------------------

# Qui transcrit le vocal : `openai`, `groq` ou `autre`. Vide, il se déduit des clés
# comme le chiffrage : OpenAI si sa clé est là, sinon Groq.
TRANSCRIPTION_PROVIDER=
MODEL_TRANSCRIPTION_OPENAI=gpt-4o-transcribe

# Modèle Groq, si TRANSCRIPTION_PROVIDER=groq — ou celui du fournisseur `autre`.
MODEL_TRANSCRIPTION=whisper-large-v3-turbo

# TRANSCRIPTION_PROVIDER=autre : n'importe quel fournisseur au format OpenAI —
# Fireworks, ou un Whisper local. Une URL renseignée ici suffit à le choisir.
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=


# --- Mise en ligne --------------------------------------------------------

# Le domaine servi par Caddy. Nécessaire uniquement pour `docker-compose.prod.yml`.
# Caddy obtient et renouvelle le certificat tout seul, à condition que ce nom pointe
# vers la machine.
#
# HTTPS n'est pas un luxe ici : le micro d'un navigateur ne s'ouvre pas sur une page
# non sécurisée. Sans certificat, pas de dictée en rendez-vous.
#
# Pas de domaine ? DuckDNS en donne un gratuitement et Let's Encrypt le reconnaît :
# https://duckdns.org -> monartisan.duckdns.org
DOMAINE=

# À qui l'application fait confiance pour écrire l'adresse réelle de l'appelant.
# Ne toucher que derrière un reverse proxy, ET seulement si le port 8000 est fermé
# au monde extérieur : `*` accepte l'en-tête de n'importe qui, donc n'importe qui
# s'inventerait une adresse neuve à chaque requête pour échapper au débit.
# `docker-compose.prod.yml` le pose lui-même, parce qu'il ferme le port en même temps.
FORWARDED_ALLOW_IPS=127.0.0.1


# --- Garde-fous -----------------------------------------------------------

# LE GESTE DE LA MISE EN LIGNE. Tant que cette ligne est vide, tout est ouvert —
# c'est ce qu'on veut en développement. La renseigner ferme la porte : les routes
# coûteuses exigent alors ce code, et la page le réclame avant tout le reste.
#
# Ce n'est pas une authentification : c'est un mot de passe unique, qu'on donne de
# vive voix en rendez-vous, en attendant les comptes. Prendre quelque chose de long
# et sans rapport avec le projet ; le navigateur le retient, personne ne le retape.
#
# Sans lui, quiconque trouve l'URL fait tourner le chiffrage sur ta clé et à tes frais.
ACCES_CODE=

# Requêtes par minute et par adresse. Trente laisse passer un artisan pressé qui
# reclique, et arrête une boucle.
LIMITE_PAR_MINUTE=30

# Les plafonds de chiffrages, tous appelants confondus. C'est le garde-fou du
# portefeuille : au-delà, plus aucun appel payant ne part. Ils protègent de ce que le
# code d'accès ne couvre pas — un code qui a circulé, un script resté en boucle, une
# fausse manœuvre. Zéro les désactive.
#
# Deux échelles, parce qu'une seule ne suffit pas : 80 par jour laisse passer 2 400
# devis dans le mois. Le journalier attrape l'emballement, le mensuel attrape la
# fuite lente qu'il laisserait filer sans jamais broncher.
DEVIS_PAR_JOUR=80
DEVIS_PAR_MOIS=400

# Où les compteurs sont écrits pour survivre à un redémarrage. Un plafond qu'on
# annule en relançant l'application ne protège de rien.
#
# EN CONTENEUR, CE CHEMIN DOIT ÊTRE SUR UN VOLUME. Sans ça, chaque déploiement repart
# de zéro et on retombe exactement sur le problème qu'on voulait régler.
COMPTEURS_FICHIER=var/compteurs.json

# Taille maximale d'un corps JSON, et nombre de lignes d'un devis. Les deux existent
# pour la même raison : /api/pdf accepte un devis fabriqué par le client, et cinquante
# mille lignes occuperaient Chromium plusieurs minutes.
MAX_JSON_KO=512
MAX_LIGNES_DEVIS=60

# Rendus PDF simultanés. Chaque page Chromium coûte de la mémoire, et c'est elle qui
# manque en premier sur un petit serveur — bien avant le processeur.
RENDUS_SIMULTANES=2


# --- Règles de devis ------------------------------------------------------

# 0.10 = rénovation d'un logement achevé depuis plus de 2 ans (le cas courant).
# 0.20 = neuf, local professionnel.
TVA_DEFAUT=0.10
VALIDITE_JOURS=30
ACOMPTE_PCT=0.30
MAX_UPLOAD_MO=25


# --- En-tête du devis -----------------------------------------------------
#
# Ces valeurs ne sont plus qu'un repli. L'identité de l'artisan se renseigne
# maintenant depuis la page — la ligne « Votre entreprise » de l'écran d'accueil —
# où une recherche par nom remplit sept champs d'un coup depuis l'annuaire public,
# numéro de TVA compris. Le navigateur la conserve ; ce qui y est saisi recouvre ce
# qui suit, et ce qui y est laissé vide laisse passer ce qui suit.
#
# Les remplir ici garde deux usages : préparer une démonstration à l'avance, et
# servir de valeurs par défaut à un poste qui ne les aurait jamais saisies.
#
# Seuls l'assurance décennale et l'IBAN doivent être demandés à l'artisan — ce qui
# fait une bonne réplique : « ces deux champs, vous les renseignez une fois pour
# toutes ; tout le reste, je le retrouve ».
#
# Les identifiants légaux sont laissés à zéro, et pas remplis de valeurs plausibles :
# un devis dont l'argument est la conformité aux mentions obligatoires ne peut pas
# porter un faux SIRET crédible.

ENTREPRISE_NOM=Bâti Rénov
ENTREPRISE_FORME_JURIDIQUE=SARL au capital de 10 000 €
# Le métier, en capitales sous la raison sociale du devis. Deux ou trois mots.
ENTREPRISE_METIER=Rénovation · Plomberie · Second œuvre
ENTREPRISE_ADRESSE=12 rue des Compagnons
ENTREPRISE_CODE_POSTAL_VILLE=75011 Paris
ENTREPRISE_TELEPHONE=00 00 00 00 00
ENTREPRISE_EMAIL=contact@example.com
ENTREPRISE_SIRET=000 000 000 00000
ENTREPRISE_CODE_APE=4399C
ENTREPRISE_TVA_INTRACOM=FR00 000 000 000
ENTREPRISE_ASSURANCE=Assureur à renseigner
ENTREPRISE_ASSURANCE_POLICE=000 000 000
ENTREPRISE_IBAN=FR76 0000 0000 0000 0000 0000 000


# --- Firebase : comptes et gabarit personnel ------------------------------
#
# HORS DU PÉRIMÈTRE D'ORIGINE. CLAUDE.md classe « comptes / auth / multi-tenant » et
# « base de données » dans ce qu'il ne faut pas construire ; l'ajout a été fait sur
# décision explicite. Ces variables sont donc toutes facultatives.
#
# LAISSÉES VIDES, RIEN NE CHANGE : pas d'écran de connexion, pas de gabarit
# personnel, et le démonstrateur se comporte exactement comme avant. C'est le mode
# par défaut, et celui dans lequel `uv run pytest` doit continuer de passer.
#
# L'authentification ne s'allume QUE si le serveur peut vérifier un jeton, c'est-à-dire
# si FIREBASE_CREDENTIALS ou FIREBASE_CREDENTIALS_JSON est renseigné. Les trois clés
# publiques seules ne suffisent pas : un écran de connexion devant une API non
# protégée serait une porte peinte sur un mur.
#
# Pour armer le tout, sur https://console.firebase.google.com :
#   1. créer un projet, puis Authentication > Sign-in method : activer Google et
#      « E-mail/Mot de passe » ;
#   2. Firestore Database : créer la base (mode production) — c'est là que vivent les
#      gabarits, un document par compte dans la collection `gabarits` ;
#   3. Paramètres du projet > Général : les trois valeurs publiques ci-dessous ;
#   4. Paramètres du projet > Comptes de service > « Générer une clé privée » : le
#      fichier JSON, à ne JAMAIS commiter.

# Le compte de service. Deux formes, une seule à renseigner.
# En local, le chemin du fichier :
# FIREBASE_CREDENTIALS=./firebase-service-account.json
# En déploiement (Coolify injecte des variables, il ne dépose pas de fichiers), le
# JSON entier sur une ligne :
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# La configuration publique du SDK navigateur. Ce ne sont pas des secrets : Firebase
# les publie dans le code de toute page qui l'utilise. Servies au front par
# /api/firebase plutôt qu'écrites en dur dans app.js.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=mon-projet.firebaseapp.com
# FIREBASE_PROJECT_ID=mon-projet

# Taille maximale d'un gabarit téléversé. Les images doivent y être des URI `data:`,
# d'où une limite plus large qu'un simple fichier HTML.
# MAX_GABARIT_KO=512

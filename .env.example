# ---------------------------------------------------------------------------
# Copier ce fichier en `.env` et renseigner les valeurs. Le `.env` n'est jamais commité.
#
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- Clés API -------------------------------------------------------------

# La seule clé nécessaire par défaut : elle sert à la transcription et au chiffrage.
# https://platform.openai.com/api-keys — facturé à l'usage, pas de tier gratuit.
OPENAI_API_KEY=

# Nécessaire seulement si TRANSCRIPTION_PROVIDER=groq ou STRUCTURATION_PROVIDER=groq.
# Compte gratuit sur https://console.groq.com — pas de carte bancaire.
GROQ_API_KEY=

# Nécessaire seulement si STRUCTURATION_PROVIDER=anthropic. https://console.anthropic.com
ANTHROPIC_API_KEY=


# --- Mode hors-ligne ------------------------------------------------------

# true  : rejoue les extractions enregistrées dans tests/fixtures/. Aucun appel API,
#         aucun euro dépensé. C'est le mode de travail pour itérer sur le PDF et le front.
# false : appelle réellement Claude.
USE_FIXTURES=true


# --- Journal de démonstration ---------------------------------------------

# Garde sur disque chaque vocal réel, sa transcription et ce que le modèle en a tiré,
# dans journal/<date>/<heure-empreinte>/. À armer avant une tournée de rendez-vous :
# ce sont ces enregistrements-là, et pas des fonctionnalités, qui font progresser le
# prompt. Rien n'est jamais relu par l'application, et le dossier est ignoré par git.
#
# Il enregistre la voix de quelqu'un : le dire à l'artisan avant n'est pas une option.
JOURNAL=false


# --- Modèles --------------------------------------------------------------

# Qui chiffre le devis : `openai`, `anthropic` ou `groq`. `openai` est le choix par
# défaut. `groq` est gratuit et sert à dégrossir : les prix dictés par l'artisan sont
# repris à l'identique, mais les prix estimés sortent 40 % trop bas. Voir
# CONTRIBUTING.md. `openai` et `groq` passent par le même chemin de code — même prompt,
# même sortie contrainte — donc la comparaison entre fournisseurs est honnête.
STRUCTURATION_PROVIDER=openai
MODEL_STRUCTURATION_OPENAI=gpt-5
MODEL_STRUCTURATION_GROQ=openai/gpt-oss-120b
# Modèle Anthropic, si STRUCTURATION_PROVIDER=anthropic.
MODEL_STRUCTURATION=claude-opus-5

# Qui transcrit le vocal : `openai` ou `groq`.
TRANSCRIPTION_PROVIDER=openai
MODEL_TRANSCRIPTION_OPENAI=gpt-4o-transcribe
# Modèle Groq, si TRANSCRIPTION_PROVIDER=groq.
MODEL_TRANSCRIPTION=whisper-large-v3-turbo


# --- Règles de devis ------------------------------------------------------

# 0.10 = rénovation d'un logement achevé depuis plus de 2 ans (le cas courant).
# 0.20 = neuf, local professionnel.
TVA_DEFAUT=0.10
VALIDITE_JOURS=30
ACOMPTE_PCT=0.30
MAX_UPLOAD_MO=25


# --- En-tête du devis -----------------------------------------------------
#
# À remplir avec l'identité de l'artisan AVANT chaque rendez-vous. Un devis à son nom,
# avec son vrai SIRET, est le meilleur argument du produit — et il coûte deux minutes.
#
# Les huit premières lignes sont publiques : cherche son entreprise sur
# https://annuaire-entreprises.data.gouv.fr et tu as le SIRET, le code APE, l'adresse
# et de quoi former le n° de TVA. Seuls l'assurance décennale et l'IBAN doivent lui
# être demandés — ce qui fait une bonne réplique : « ces deux champs, vous les
# renseignez une fois pour toutes ; tout le reste, je l'ai déjà ».
#
# Les identifiants légaux sont laissés à zéro, et pas remplis de valeurs plausibles :
# un devis dont l'argument est la conformité aux mentions obligatoires ne peut pas
# porter un faux SIRET crédible.

ENTREPRISE_NOM=Bâti Rénov
ENTREPRISE_FORME_JURIDIQUE=SARL au capital de 10 000 €
# Le métier, en capitales sous la raison sociale du devis. Deux ou trois mots.
ENTREPRISE_METIER=Rénovation · Plomberie · Second œuvre
ENTREPRISE_ADRESSE=12 rue des Compagnons
ENTREPRISE_CODE_POSTAL_VILLE=75011 Paris
ENTREPRISE_TELEPHONE=00 00 00 00 00
ENTREPRISE_EMAIL=contact@example.com
ENTREPRISE_SIRET=000 000 000 00000
ENTREPRISE_CODE_APE=4399C
ENTREPRISE_TVA_INTRACOM=FR00 000 000 000
ENTREPRISE_ASSURANCE=Assureur à renseigner
ENTREPRISE_ASSURANCE_POLICE=000 000 000
ENTREPRISE_IBAN=FR76 0000 0000 0000 0000 0000 000
